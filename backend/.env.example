# NEXUS environment configuration
# Copy to .env and adjust values for your environment.

# --- App ---
ENVIRONMENT=development
DEBUG=true
DEMO_MODE=true
APP_VERSION=1.0.0

# --- Database ---
# Leave unset for the launcher default (SQLite backend/nexus.db, zero config).
# For PostgreSQL:
DATABASE_URL=postgresql://nexus:nexus@localhost:5432/nexus
REDIS_URL=redis://localhost:6379/0

# --- Security ---
# Generate a strong secret for production: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173

# --- AI (OpenAI) ---
# Leave empty to run in demo mode (rule-based fallbacks, no API calls).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100

# --- Ops ---
OPS_WINDOW_BACKEND_MINUTES=60

# --- Launcher (python app.py) ---
# PORT=8000
# NEXUS_HOST=127.0.0.1
# NEXUS_NO_BROWSER=0   # set to 1 to disable auto-opening the browser
# NEXUS_REBUILD=0      # set to 1 to force a frontend rebuild on next run