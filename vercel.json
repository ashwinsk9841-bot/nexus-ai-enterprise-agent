{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pip install -r requirements.txt",
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "app.py": {
      "includeFiles": "frontend/dist/**",
      "maxDuration": "max"
    }
  }
}
